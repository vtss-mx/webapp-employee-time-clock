# Sirve la SPA y es el GATEWAY de la API: /api, /api/ws y /docs van a las réplicas del backend (mismo
# origen: sin CORS ni contenido mixto). Las réplicas no publican puertos; solo se llega a ellas por aquí.
#
# PLANTILLA: 15-gateway-config.sh la escribe en /etc/nginx/conf.d/default.conf al arrancar sustituyendo SOLO las
# variables ${NGINX_*} (lo que depende de cuántas réplicas hay y del equipo; vienen de docker-compose.yml y sus valores
# viven en el .env de la raíz, README §7). Las demás $variables son de Nginx y quedan intactas.

# Detrás de ngrok u otro proxy TLS se respeta el esquema original (https).
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

# traceId: se conserva el X-Request-ID del cliente solo si es seguro (se inserta en JSON);
# de lo contrario se genera uno en el proxy.
# Idioma de los errores que responde el propio gateway (regla 16: nunca se mezclan idiomas): el de la petición
# (`Accept-Language`, como el backend: `en*` → en-US; lo demás → es-MX). Los textos son los del catálogo de mensajes
# del backend (SERVICE_UNAVAILABLE, PAYLOAD_TOO_LARGE) y el sobre lleva su `i18n` como cualquier error (regla 3).
map $http_accept_language $api_locale {
  ~*^\s*en en-US;
  default es-MX;
}

map $api_locale $api_unavailable_message {
  en-US "Service unavailable. Try again in a few seconds.";
  default "Servicio no disponible. Intenta de nuevo en unos segundos.";
}

map $api_locale $api_too_large_message {
  en-US "The content exceeds the maximum allowed size";
  default "El contenido excede el tamaño máximo permitido";
}

map $http_x_request_id $trace_id {
  default                    $request_id;
  "~^[A-Za-z0-9._-]{8,64}$"  $http_x_request_id;
}

# Réplicas de la API (`docker compose up -d --scale backend=N`; BACKEND_REPLICAS, 5 por omisión).
# - `resolve` + resolver de Docker: el nombre `backend` devuelve la IP de CADA réplica y se vuelve a resolver
#   cada NGINX_RESOLVER_VALID (5 s): una réplica nueva recibe tráfico sola y una que se fue deja de recibirlo, sin
#   reiniciar Nginx.
# - `least_conn`: la siguiente petición va a la réplica con menos peticiones en curso (las faciales tardan
#   segundos; por turnos se amontonarían en una).
# - `max_fails` / `fail_timeout` (NGINX_UPSTREAM_MAX_FAILS 1, NGINX_UPSTREAM_FAIL_TIMEOUT 10s): si conectar a una
#   réplica falla (se cayó), se salta ese tiempo mientras el DNS deja de anunciarla (con una sola réplica Nginx la
#   sigue intentando siempre).
# - Conexiones persistentes (NGINX_UPSTREAM_KEEPALIVE por proceso de Nginx; ≥ 2 × réplicas × API_WORKERS) recicladas
#   cada NGINX_UPSTREAM_KEEPALIVE_REQUESTS peticiones: cada réplica corre varios procesos que comparten el socket y
#   una conexión persistente queda fija en un proceso; reciclarlas reparte la carga entre todos. Viven ociosas
#   NGINX_UPSTREAM_KEEPALIVE_TIMEOUT, MENOR que UVICORN_TIMEOUT_KEEP_ALIVE (5 s): cierra primero el proxy.
resolver 127.0.0.11 valid=${NGINX_RESOLVER_VALID} ipv6=off;
resolver_timeout 2s;
upstream api_backend {
  zone api_backend 64k;
  least_conn;
  server backend:8000 resolve max_fails=${NGINX_UPSTREAM_MAX_FAILS} fail_timeout=${NGINX_UPSTREAM_FAIL_TIMEOUT};
  keepalive ${NGINX_UPSTREAM_KEEPALIVE};
  keepalive_requests ${NGINX_UPSTREAM_KEEPALIVE_REQUESTS};
  keepalive_timeout ${NGINX_UPSTREAM_KEEPALIVE_TIMEOUT};
}

# ¿Redirigir a HTTPS? Sí cuando la página llega por http:// y no es localhost (la cámara exige
# contexto seguro). Se resuelve aquí (no con varios "if" en location, que rompen try_files).
map "$forwarded_proto:$host" $needs_https {
  default 0;
  "~*^http:(?!localhost$|127\.0\.0\.1$)" 1;
}

# WebSocket: el encabezado Connection depende de si el cliente pide "upgrade".
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Caché del navegador y de una CDN, por archivo (una sola cabecera en el server: un add_header dentro de un
# location anularía las cabeceras de seguridad heredadas). Vacío = no se agrega (la API decide la suya).
# - /assets/: nombres con hash de Vite, nunca cambian → un año e inmutable.
# - index.html y version.json: siempre se revalidan (una publicación nueva se ve al recargar y la app detecta
#   que hay versión nueva).
map $uri $cache_control {
  default            "";
  ~^/assets/         "public, max-age=31536000, immutable";
  ~^/mediapipe/      "public, max-age=2592000";
  /index.html        "no-cache";
  /version.json      "no-cache";
  ~\.(png|ico|webmanifest)$  "public, max-age=86400";
}

# ---------- Cabeceras de seguridad de la página que EJECUTA JavaScript ----------
# Brecha A1 de `backend-employee-time-clock/docs/rd/certificaciones-seguridad-2026-10-08.md` (SOC 2 CC6.6 y CC6.7;
# ISO/IEC 27001 A.8.20, A.8.23 y A.8.26): la API ya pone su CSP y su HSTS (`app/middleware/security.py`), pero la
# página de la aplicación —la que corre en el navegador de la persona— no las ponía, y es la que más las necesita.
#
# ¿A qué respuestas se les pone? SOLO a las de la aplicación web. Un `add_header` dentro de un `location` anularía
# TODAS las cabeceras heredadas del `server` (ya advertido arriba), así que la distinción se hace con un `map` y una
# sola cabecera: vacío = no se agrega (así lo hace Nginx cuando el valor queda vacío, igual que $cache_control).
#   - `/api/` (incluido `/api/ws/`): la API manda su propia CSP `default-src 'none'`, más estricta; duplicarla aquí
#     solo confundiría a un escáner.
#   - `/docs`, `/redoc`, `/openapi.json`: Swagger UI se dibuja con un script en línea y hojas de un CDN; con la CSP
#     de la aplicación encima quedaría en blanco (el backend la excluye por la misma razón).
map $uri $served_by_app {
  default                        1;
  ~^/api/                        0;
  ~^/(docs|redoc|openapi\.json)$ 0;
}

# CSP real de la aplicación, acotada a lo que el código pide de verdad (verificado contra `src/`):
#   default-src 'self' .......... todo lo demás, del mismo origen (la API va por este mismo gateway).
#   script-src .................. 'self' (el paquete de Vite y sus `modulepreload`); 'wasm-unsafe-eval' porque el
#       detector facial compila WebAssembly en el navegador (`@mediapipe/tasks-vision`: `instantiateStreaming`) y sin
#       él se cae la captura; el hash del ÚNICO script EN LÍNEA del `index.html` construido (el aviso «Actualiza tu
#       navegador», decisión D-C1, que `vite.config.ts` inserta al final del `<body>`) — lo calcula al arrancar
#       `15-gateway-config.sh` del archivo REALMENTE publicado, así nunca queda desalineado con una compilación nueva;
#       y los dos orígenes que cargan código de Google: `maps.googleapis.com`/`maps.gstatic.com` (el SDK del mapa, que
#       se inyecta en `src/services/maps/googleMaps.ts`) y `www.googletagmanager.com` (gtag.js, que carga
#       `@firebase/analytics`). SIN 'unsafe-inline' y SIN 'unsafe-eval': nada del código los necesita.
#   style-src ................... con 'unsafe-inline', y es una decisión medida: el `<style>` del aviso de navegador y
#       los `<style>` que el SDK del mapa inyecta en tiempo de ejecución. Un hash aquí APAGARÍA 'unsafe-inline' (regla
#       de la propia CSP) y dejaría el mapa sin estilos. Un estilo en línea no ejecuta código; lo que de verdad frena
#       un ataque son script-src, object-src y base-uri, que sí quedan cerrados.
#   img-src ..................... 'self' + `data:` (el QR que se dibuja en el navegador, la evidencia y las fotos que
#       la API manda en base64) + `blob:` (foto de perfil y recortes, que viven solo en memoria) + los dominios de
#       imágenes de Google (mosaicos del mapa).
#   font-src .................... las fuentes propias son locales; `fonts.gstatic.com` es la Roboto de los rótulos del
#       mapa (si no llega, el mapa solo cambia de tipografía).
#   media-src ................... `blob:` por el clip de video de la verificación por voz.
#   worker-src .................. hoy la aplicación no crea ninguno; `blob:` queda para el renderizador vectorial del
#       mapa, que sí los crea desde código del propio origen.
#   connect-src ................. 'self' cubre la API y el canal en vivo (CSP 3 hace coincidir `wss://` del MISMO host
#       con 'self' en todos los navegadores que la app admite: Safari 16.4, Chrome/Edge 111, Firefox 114), más los
#       servicios de Google que el código llama: mapa, Places y Geocoding, `www.googleapis.com` (Geolocation),
#       `storage.googleapis.com` (respaldo del modelo facial), Firebase y la analítica. NO se permite
#       `odml.pa.googleapis.com`: es la telemetría propia del SDK de MediaPipe y bloquearla es justo lo que pide la
#       regla 13 (los datos no salen hacia terceros); el SDK la hace en un try/catch y no se entera.
#   frame-ancestors 'none' ...... nadie nos puede enmarcar (con X-Frame-Options para navegadores viejos).
#   frame-src ................... el SDK del mapa crea un `<iframe>` propio dentro de `.gm-style`.
#   object-src 'none', base-uri 'self', form-action 'self' ... sin plugins, sin reescribir la base de las URL
#       relativas y sin enviar un formulario a otro origen.
# Lo que depende del despliegue es variable del `.env` de la raíz (regla 19): el modo (bloquear u observar), los
# orígenes extra de connect-src (una API en otro dominio) y las directivas extra del final (p. ej. `report-uri`). Una
# directiva repetida la ignora el navegador, así que NGINX_CSP_EXTRA puede añadir, nunca relajar.
map $served_by_app $app_csp {
  default "";
  1       "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' ${NGINX_CSP_SCRIPT_HASHES} https://maps.googleapis.com https://maps.gstatic.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.ggpht.com https://*.googleusercontent.com; font-src 'self' https://fonts.gstatic.com; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://maps.googleapis.com https://maps.gstatic.com https://www.googleapis.com https://storage.googleapis.com https://firebase.googleapis.com https://firebaseinstallations.googleapis.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com ${NGINX_CSP_CONNECT_EXTRA}; frame-src 'self' https://*.google.com; manifest-src 'self'; ${NGINX_CSP_EXTRA}";
}

# Aislamiento del contexto del navegador. COOP corta la relación con cualquier ventana que nos abra o que abramos
# (los enlaces a Google Maps o a db-ip.com salen con `target="_blank"` y no necesitan `window.opener`).
# COEP va en `credentialless`, NO en `require-corp`: nada de la aplicación necesita `crossOriginIsolated` (no hay
# SharedArrayBuffer ni hilos; MediaPipe corre en el hilo principal), y `require-corp` bloquearía el SDK del mapa,
# gtag.js y el modelo de `storage.googleapis.com`, que no envían `Cross-Origin-Resource-Policy`. `credentialless`
# pide los recursos de terceros SIN credenciales y no exige esa cabecera: endurece sin romper nada. Un despliegue sin
# Google puede subirlo a `require-corp`, o dejarlo vacío para no enviarlo.
map $served_by_app $app_coop {
  default "";
  1       "${NGINX_COOP}";
}
map $served_by_app $app_coep {
  default "";
  1       "${NGINX_COEP}";
}
# HSTS solo cuando la página se sirve por HTTPS (detrás de ngrok o de un balanceador se mira el esquema original),
# como hace la API en producción. Vacío = no se envía (un entorno por http:// no debe fijar la política).
map "$served_by_app$forwarded_proto" $app_hsts {
  default "";
  1https  "${NGINX_HSTS}";
}

server {
  listen 80;
  listen 443 ssl;
  http2 on;
  server_name _;

  ssl_certificate     /etc/nginx/certs/server.crt;
  ssl_certificate_key /etc/nginx/certs/server.key;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1h;

  root /usr/share/nginx/html;
  index index.html;

  # 5 imágenes de 5 MB + margen, o un documento de la empresa (debe ser >= al mayor límite del backend)
  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  # Archivos estáticos: ya comprimidos al construir la imagen (.gz, nivel 9, cero CPU por petición).
  # Respuestas de la API: se comprimen al vuelo. Brotli no viene en los paquetes oficiales de Nginx; con una
  # CDN delante, ella lo ofrece en el borde.
  gzip_static on;
  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_proxied any;   # también comprime las respuestas JSON de la API
  gzip_vary on;
  gzip_types text/css text/plain application/javascript application/json application/manifest+json image/svg+xml application/wasm font/ttf;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  # La app usa la cámara (rostro, QR), el micrófono (video con preguntas del registro de identidad) y la ubicación
  # (inicio de sesión del validador, "Mi ubicación" del domicilio) solo desde su propio origen; una lista vacía como
  # `geolocation=()` o `microphone=()` lo bloquearía también para nosotros.
  add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)" always;
  add_header Cache-Control $cache_control;

  # Cabeceras de seguridad de la aplicación web (los `map` de arriba explican cada directiva y dejan el valor vacío
  # en /api y /docs, donde no deben ir). Con el valor vacío Nginx no agrega la cabecera.
  add_header ${NGINX_CSP_HEADER} $app_csp always;
  add_header Cross-Origin-Opener-Policy $app_coop always;
  add_header Cross-Origin-Embedder-Policy $app_coep always;
  add_header Strict-Transport-Security $app_hsts always;

  # Hacia la API (cabeceras en proxy-headers.conf, incluido en cada location que hace proxy).
  proxy_http_version 1.1;
  proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
  # Si conectar a una réplica falla (se apaga o se cayó), la petición va a otra: aún no se envió, así que
  # es seguro también para un POST. Una petición ya enviada solo se reintenta si es idempotente (GET...).
  proxy_next_upstream error timeout;
  proxy_next_upstream_tries ${NGINX_PROXY_NEXT_UPSTREAM_TRIES};
  proxy_next_upstream_timeout ${NGINX_PROXY_NEXT_UPSTREAM_TIMEOUT};

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Canal en tiempo real (validación de datos únicos): conexión persistente con upgrade.
  location /api/ws/ {
    proxy_pass http://api_backend;
    include /etc/nginx/proxy-headers.conf;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout ${NGINX_WS_READ_TIMEOUT}; # el servidor cierra por inactividad a los 300 s
    proxy_send_timeout ${NGINX_WS_READ_TIMEOUT};
    proxy_buffering off;
  }

  location /api/ {
    proxy_pass http://api_backend;
    include /etc/nginx/proxy-headers.conf;
    proxy_set_header Connection "";
    proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
    # Errores generados por el proxy (no por el backend) también usan el contrato único de
    # respuesta, nunca una página HTML.
    error_page 502 503 504 = @api_unavailable;
    error_page 413 = @api_too_large;
  }

  location @api_unavailable {
    add_header Content-Language $api_locale always;
    add_header Vary Accept-Language always;
    default_type application/json;
    add_header Retry-After 5 always;
    add_header X-Request-ID $trace_id always;
    add_header Cache-Control "no-store" always;
    return 503 '{"success":false,"statusCode":503,"code":"SERVICE_UNAVAILABLE","message":"$api_unavailable_message","data":null,"errors":[{"code":"SERVICE_UNAVAILABLE","message":"$api_unavailable_message","field":null,"details":null}],"i18n":{"es-MX":{"message":"Servicio no disponible. Intenta de nuevo en unos segundos.","errors":["Servicio no disponible. Intenta de nuevo en unos segundos."],"texts":[]},"en-US":{"message":"Service unavailable. Try again in a few seconds.","errors":["Service unavailable. Try again in a few seconds."],"texts":[]}},"traceId":"$trace_id","timestamp":"$time_iso8601"}';
  }

  location @api_too_large {
    add_header Content-Language $api_locale always;
    add_header Vary Accept-Language always;
    default_type application/json;
    add_header X-Request-ID $trace_id always;
    add_header Cache-Control "no-store" always;
    return 413 '{"success":false,"statusCode":413,"code":"PAYLOAD_TOO_LARGE","message":"$api_too_large_message","data":null,"errors":[{"code":"PAYLOAD_TOO_LARGE","message":"$api_too_large_message","field":null,"details":null}],"i18n":{"es-MX":{"message":"El contenido excede el tamaño máximo permitido","errors":["El contenido excede el tamaño máximo permitido"],"texts":[]},"en-US":{"message":"The content exceeds the maximum allowed size","errors":["The content exceeds the maximum allowed size"],"texts":[]}},"traceId":"$trace_id","timestamp":"$time_iso8601"}';
  }

  # Swagger del backend por la misma URL de la app (también en la IP de la red local y en ngrok).
  location ~ ^/(docs|redoc|openapi.json)$ {
    proxy_pass http://api_backend;
    include /etc/nginx/proxy-headers.conf;
    proxy_set_header Connection "";
  }

  # Nombres con hash: si no existe es un 404 (nunca index.html en su lugar, que el navegador tomaría por JS).
  location /assets/ {
    try_files $uri =404;
  }

  location /mediapipe/ {
    types {
      application/wasm wasm;
      application/javascript js;
      application/octet-stream tflite;
    }
  }

  # SPA: cualquier ruta del cliente devuelve index.html
  location / {
    # La cámara solo funciona en HTTPS (o localhost). Quien abre la app por http://<IP> desde otra
    # computadora o un teléfono se redirige a https://<IP>:8443. ngrok y otros proxies TLS ya llegan
    # con X-Forwarded-Proto: https y no se redirigen.
    if ($needs_https) {
      return 301 https://$host:8443$request_uri;
    }
    try_files $uri /index.html;
  }
}
